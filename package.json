{
  "name": "tidy-desktop",
  "version": "2.8.5",
  "description": "桌面整理应用",
  "author": "Wan-Wuan",
  "license": "MIT",
  "repository": "https://github.com/Wan-Wuan/tidy-desktop",
  "homepage": "https://github.com/Wan-Wuan/tidy-desktop",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:main": "node scripts/clean-main-build.mjs && tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"tsc -p tsconfig.main.json && node scripts/wait-for-vite-electron.mjs\"",
    "electron:build": "vite build && npm run build:main && npm run verify:icons && electron-builder",
    "icons:generate": "node scripts/generate-icons.mjs",
    "verify:icons": "node scripts/check-icons.mjs",
    "verify:icons:exe": "node scripts/check-icons.mjs --exe",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "release": "node scripts/release.mjs",
    "publish:github": "node scripts/publish-github-release.mjs",
    "publish:gitee": "node scripts/publish-gitee-release.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "pinyin-pro": "^3.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^25.9.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.0"
  }
}
