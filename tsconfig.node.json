{
  // 校验 vite.config.ts 这类「仅 Node 侧」的脚本（ESM + bundler 解析）。
  // vite 自身用 esbuild 解析配置、不经 tsc，所以这份配置的价值在于把配置文件的
  // 类型错误也纳入 `npm run typecheck:node`，而不是留给编辑器碰运气。
  // 注意不要加 "composite": true——它是给 project references 用的，且与 --noEmit 冲突；
  // 本仓库没有任何地方引用它。
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
